rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================
    // HELPER FUNCTIONS
    // =========================================================

    // Is the caller authenticated?
    function isAuth() {
      return request.auth != null;
    }

    // Get calling user's profile doc
    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Does caller belong to this business?
    function isMember(businessId) {
      return isAuth() && userDoc().businessId == businessId;
    }

    // Is caller the owner of this business?
    function isOwner(businessId) {
      return isMember(businessId) && userDoc().role == 'owner';
    }

    // Is caller owner or manager?
    function isManager(businessId) {
      let user = userDoc();
      return isAuth() && user.businessId == businessId &&
        (user.role == 'owner' || user.role == 'manager');
    }

    // =========================================================
    // BUSINESSES
    // Members can read their own business doc.
    // Only Cloud Functions (Admin SDK) can write.
    // =========================================================
    match /businesses/{businessId} {
      allow read: if isMember(businessId);
      allow write: if false; // All writes via Cloud Functions only
    }

    // =========================================================
    // USERS
    // A user can read their own profile.
    // Owner can read all users in their business.
    // All writes via Cloud Functions only.
    // =========================================================
    match /users/{uid} {
      allow read: if isAuth() && (
        request.auth.uid == uid ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         userDoc().businessId == resource.data.businessId &&
         userDoc().role == 'owner')
      );
      allow write: if false; // All writes via Cloud Functions only
    }

    // =========================================================
    // PRODUCTS
    // Members can read. Only owner/manager can write directly
    // (but in practice all writes go through Cloud Functions).
    // =========================================================
    match /products/{productId} {
      allow read: if isAuth() &&
        isMember(resource.data.businessId);

      // Deny direct client writes — all mutations via Cloud Functions
      allow create, update, delete: if false;
    }

    // =========================================================
    // SALES
    // All members can read. No direct client writes.
    // =========================================================
    match /sales/{saleId} {
      allow read: if isAuth() &&
        isMember(resource.data.businessId);
      allow create, update, delete: if false;
    }

    // =========================================================
    // HR & PAYROLL
    // =========================================================
    match /payroll/{payrollId} {
      allow read: if isManager(resource.data.businessId) || (isAuth() && resource.data.userId == request.auth.uid);
      allow write: if false;
    }
    match /timesheets/{timesheetId} {
      allow read: if isManager(resource.data.businessId) || (isAuth() && resource.data.userId == request.auth.uid);
      allow write: if false;
    }
    match /leaves/{leaveId} {
      allow read: if isManager(resource.data.businessId) || (isAuth() && resource.data.userId == request.auth.uid);
      allow write: if false;
    }

    // =========================================================
    // BILLING & PAYMENTS
    // =========================================================
    match /mpesa_requests/{requestId} {
      allow read: if isMember(resource.data.businessId);
      allow write: if false;
    }
    match /payment_settings/{settingsId} {
      allow read: if isManager(resource.data.businessId);
      allow write: if false;
    }

    // =========================================================
    // EXPENSES
    // Owner/Manager can read. No direct client writes.
    // =========================================================
    match /expenses/{expenseId} {
      allow read: if isAuth() &&
        isManager(resource.data.businessId);
      allow create, update, delete: if false;
    }

    // =========================================================
    // PURCHASES
    // Owner/Manager can read. No direct client writes.
    // =========================================================
    match /purchases/{purchaseId} {
      allow read: if isAuth() &&
        isManager(resource.data.businessId);
      allow create, update, delete: if false;
    }

    // =========================================================
    // STOCK MOVEMENTS
    // All members can read (for transparency). No direct writes.
    // =========================================================
    match /stockMovements/{movementId} {
      allow read: if isAuth() &&
        isMember(resource.data.businessId);
      allow create, update, delete: if false;
    }

    // =========================================================
    // PLANS
    // Public read (all users can view plans). No direct client writes.
    // =========================================================
    match /plans/{planId} {
      allow read: if true; // Plans are public
      allow create, update, delete: if false; // All writes via Cloud Functions only
    }

    // =========================================================
    // SUBSCRIPTIONS
    // Business owner can read their own subscriptions.
    // Super Admin can read all subscriptions.
    // No direct client writes.
    // =========================================================
    match /subscriptions/{subscriptionId} {
      allow read: if isAuth() && (
        userDoc().isSuperAdmin == true ||
        resource.data.businessId == userDoc().businessId
      );
      allow create, update, delete: if false; // All writes via Cloud Functions only
    }

    // =========================================================
    // SYSTEM NOTIFICATIONS
    // Business owner can read their own notifications.
    // Super Admin can read all notifications.
    // No direct client writes.
    // =========================================================
    match /systemNotifications/{notificationId} {
      allow read: if isAuth() && (
        userDoc().isSuperAdmin == true ||
        resource.data.businessId == userDoc().businessId
      );
      allow create, update, delete: if false; // All writes via Cloud Functions only
    }

    // =========================================================
    // AUDIT LOGS
    // Only Super Admin can read.
    // No direct client writes.
    // =========================================================
    match /auditLogs/{logId} {
      allow read: if isAuth() && userDoc().isSuperAdmin == true;
      allow create, update, delete: if false; // All writes via Cloud Functions only
    }

    // =========================================================
    // Cash Drawer — read-only via rules; writes via Cloud Functions
    // =========================================================
    match /cashSessions/{sessionId} {
      allow read: if isMember(resource.data.businessId);
      allow create, update, delete: if false;
    }

    // =========================================================
    // Branches — read-only via rules; writes via Cloud Functions
    // =========================================================
    match /branches/{branchId} {
      allow read: if isMember(resource.data.businessId);
      allow create, update, delete: if false;
    }

    // =========================================================
    // Stock Transfers — read-only via rules; writes via Cloud Functions
    // =========================================================
    match /stockTransfers/{transferId} {
      allow read: if isMember(resource.data.businessId);
      allow create, update, delete: if false;
    }

    // =========================================================
    // Notification Queue — read-only via rules; writes via Cloud Functions
    // =========================================================
    match /notificationQueue/{notificationId} {
      allow read: if isMember(resource.data.businessId);
      allow create, update, delete: if false;
    }

    // =========================================================
    // LOGIN ATTEMPTS — deny all direct client access
    // (managed by Cloud Functions only)
    // =========================================================
    match /loginAttempts/{docId} {
      allow read, write: if false;
    }

    // =========================================================
    // PASSWORD RESET REQUESTS — deny all direct client access
    // (managed by Cloud Functions only)
    // =========================================================
    match /passwordResetRequests/{docId} {
      allow read, write: if false;
    }

    // =========================================================
    // SUBSCRIPTION STATS — super admins can read aggregate
    // No direct client writes.
    // =========================================================
    match /subscriptionStats/{docId} {
      allow read: if isAuth() && userDoc().isSuperAdmin == true;
      allow write: if false;
    }

    // =========================================================
    // SUBSCRIPTION HISTORY — business owner or super admin can read
    // No direct client writes.
    // =========================================================
    match /subscriptionHistory/{docId} {
      allow read: if isAuth() && (
        userDoc().isSuperAdmin == true ||
        resource.data.businessId == userDoc().businessId
      );
      allow create, update, delete: if false;
    }

    // =========================================================
    // SUBSCRIPTION REMINDERS — super admin can read
    // No direct client writes.
    // =========================================================
    match /subscriptionReminders/{docId} {
      allow read: if isAuth() && userDoc().isSuperAdmin == true;
      allow write: if false;
    }

    // =========================================================
    // CUSTOMERS — Members can read. No direct client writes.
    // =========================================================
    match /customers/{customerId} {
      allow read: if isMember(resource.data.businessId);
      allow create, update, delete: if false;
    }

    // =========================================================
    // DEBT TRANSACTIONS — Manager can read. No direct writes.
    // =========================================================
    match /debtTransactions/{debtId} {
      allow read: if isManager(resource.data.businessId);
      allow create, update, delete: if false;
    }

    // =========================================================
    // QUOTATIONS — Members can read. No direct client writes.
    // =========================================================
    match /quotations/{quotationId} {
      allow read: if isMember(resource.data.businessId);
      allow create, update, delete: if false;
    }

    // =========================================================
    // PURCHASE ORDERS — Manager can read. No direct client writes.
    // =========================================================
    match /purchase_orders/{poId} {
      allow read: if isManager(resource.data.businessId);
      allow create, update, delete: if false;
    }

    // =========================================================
    // EMPLOYEES — Owner only can read HR data. No direct writes.
    // =========================================================
    match /employees/{employeeId} {
      allow read: if isOwner(resource.data.businessId);
      allow create, update, delete: if false;
    }

    // =========================================================
    // STOCK ADJUSTMENTS — Manager can read. No direct writes.
    // =========================================================
    match /stockAdjustments/{adjId} {
      allow read: if isManager(resource.data.businessId);
      allow create, update, delete: if false;
    }

    // =========================================================
    // RETURNS — Members can read. No direct client writes.
    // =========================================================
    match /returns/{returnId} {
      allow read: if isMember(resource.data.businessId);
      allow create, update, delete: if false;
    }

    // =========================================================
    // ACCOUNTING ENTRIES — Owner only can read. No direct writes.
    // =========================================================
    match /accountingEntries/{entryId} {
      allow read: if isOwner(resource.data.businessId);
      allow create, update, delete: if false;
    }

    // =========================================================
    // SUPPLIERS — Manager can read. No direct client writes.
    // =========================================================
    match /suppliers/{supplierId} {
      allow read: if isManager(resource.data.businessId);
      allow create, update, delete: if false;
    }

    // =========================================================
    // ADDITIONAL EXPLICIT RULES FOR UNPROTECTED COLLECTIONS
    // =========================================================
    
    match /chart_of_accounts/{id} { allow read: if isOwner(resource.data.businessId); allow write: if false; }
    match /hr_settings/{id} { allow read: if isMember(resource.data.businessId); allow write: if false; }
    match /tax_settings/{id} { allow read: if isMember(resource.data.businessId); allow write: if false; }
    match /storefront_settings/{id} { allow read: if isMember(resource.data.businessId); allow write: if false; }
    match /product_serials/{id} { allow read: if isMember(resource.data.businessId); allow write: if false; }
    match /product_batches/{id} { allow read: if isMember(resource.data.businessId); allow write: if false; }
    match /inventory_ledger/{id} { allow read: if isManager(resource.data.businessId); allow write: if false; }
    match /support_tickets/{id} { allow read: if isMember(resource.data.businessId); allow write: if false; }
    match /eod_settings/{id} { allow read: if isOwner(resource.data.businessId); allow write: if false; }
    match /supplier_debts/{id} { allow read: if isManager(resource.data.businessId); allow write: if false; }

    // Online Orders — merchants read their orders; writes via Cloud Functions
    match /online_orders/{id} { allow read: if isMember(resource.data.businessId); allow write: if false; }

    // Debt Payments — manager+ can read; writes via Cloud Functions
    match /debtPayments/{id} { allow read: if isManager(resource.data.businessId); allow write: if false; }

    // Storefronts — members can read their config; writes via Cloud Functions
    match /storefronts/{id} { allow read: if isMember(resource.data.businessId); allow write: if false; }

    // Admin/Internal collections — deny all direct client access
    match /platformAdmins/{id} { allow read, write: if false; }
    match /idempotency_keys/{id} { allow read, write: if false; }
    match /rateLimits/{id} { allow read, write: if false; }
    match /systemAnnouncements/{id} { allow read: if isAuth(); allow write: if false; }
    match /settings/{id} { allow read, write: if false; }
    match /subscription_plan_configs/{id} { allow read, write: if false; }

    // =========================================================
    // DEFAULT DENY — reject everything else
    // =========================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
